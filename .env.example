# ─── AVA-TIX Environment Variables ────────────────────────────────────────────
# Sao chép file này thành .env và điền các giá trị cần thiết

SECRET=avatix-dev-secret-doi-khi-deploy
PORT=3000

# ─── Turso Cloud Database (Render/Production) ──────────────────────────────────
# Để trống khi chạy local → tự dùng avatix.db
# Tạo tại: https://turso.tech → New Database → copy URL và token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Avalanche Fuji Deployer ──────────────────────────────────────────────────
# Tạo bằng: node scripts/gen-wallet.js
# Nạp AVAX testnet tại: https://faucet.avax.network
DEPLOYER_KEY=
DEPLOYER_ADDRESS=
FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc

# ─── Active Chain (tự động cập nhật khi chạy scripts/deploy.js) ───────────────
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
RELAYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AVA_TICKET_ADDRESS=
MARKETPLACE_ADDRESS=

# ─── Email OTP thật (bắt buộc cho xác thực và mua vé) ────────────────────────
# Cách 1 (Khuyên dùng cho Render Free - cổng HTTPS 443): Brevo API
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=AVA-TIX Security

# Cách 2 (Chạy local hoặc server cho phép SMTP outbound): Gmail SMTP
# SMTP_USER là Gmail của hệ thống dùng để GỬI thư; OTP được gửi tới email của user.
# Bật xác minh 2 bước trên Google và tạo App Password (không dùng mật khẩu Gmail).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
